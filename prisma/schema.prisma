// Prisma Schema for Product Browser Backend
// Using PostgreSQL with optimized composite indexes for cursor pagination

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  category  String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // @@index([updatedAt, id]) — The core pagination index.
  // When paginating by (updatedAt DESC, id DESC), PostgreSQL can do an
  // Index Scan instead of a full Seq Scan + Sort. This is the difference
  // between O(log n) and O(n) for each page fetch on 200k rows.
  @@index([updatedAt(sort: Desc), id(sort: Desc)], name: "idx_products_updated_id")

  // @@index([category, updatedAt, id]) — Used when filtering by category.
  // Composite index lets Postgres filter by category AND paginate efficiently
  // in one index pass. Without this, filtering by category would require
  // a full scan of all matching category rows before applying cursor logic.
  @@index([category, updatedAt(sort: Desc), id(sort: Desc)], name: "idx_products_category_updated_id")

  @@map("products")
}
